{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "P=python3; python3 -c '' 2>/dev/null || P=python; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/hooks/map_context.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python3; python3 -c '' 2>/dev/null || P=python; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/hooks/map_context.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "P=python3; python3 -c '' 2>/dev/null || P=python; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/hooks/map_context.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
